@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include(FindPkgConfig)

pkg_check_modules(GLIB2 REQUIRED glib-2.0>=@GLIB_MIN_VERSION@)
pkg_check_modules(CURL REQUIRED libcurl>=@CURL_MIN_VERSION@)
pkg_check_modules(UUID REQUIRED uuid>=@UUID_MIN_VERSION@)
pkg_check_modules(XML2 REQUIRED IMPORTED_TARGET libxml-2.0>=@XML_MIN_VERSION@)

find_dependency(cJSON)

include("${CMAKE_CURRENT_LIST_DIR}/BartonCommonTargets.cmake")

# Promote all imported BartonCommon targets to GLOBAL so they are visible across the entire project.
# Use CMake's IMPORTED_TARGETS property instead of parsing the generated Targets file.
get_property(_imported_targets GLOBAL PROPERTY IMPORTED_TARGETS)
foreach(_target IN LISTS _imported_targets)
    if(_target MATCHES "^BartonCommon::")
        if(TARGET "${_target}")
            set_target_properties(${_target} PROPERTIES IMPORTED_GLOBAL TRUE)
        endif()
    endif()
endforeach()
unset(_imported_targets)
unset(_target)

check_required_components(BartonCommon)
